# CharacterLock Studio — Local Configuration
# Copy to .env if you want to override automatic local discovery.

COMFYUI_URL=http://127.0.0.1:8188
COMFY_BASE_URL=http://127.0.0.1:8189
# Optional: explicit path to an existing ComfyUI_windows_portable directory
# CHARACTERLOCK_COMFYUI_DIR=C:\ComfyUI_windows_portable
CHARACTERLOCK_COMFYUI_AUTOSTART=true
CHARACTERLOCK_SDK_AUTOSTART=true
CHARACTERLOCK_COMFYUI_STARTUP_TIMEOUT=600
CHARACTERLOCK_DATA_DIR=./data
CHARACTERLOCK_MAX_UPLOAD_MB=512
CHARACTERLOCK_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
